[
  {
    "bindings": {
      "ctrl-w": null,
      "\\ w t": "terminal_panel::ToggleFocus",
      "\\ w f": "project_panel::ToggleFocus",
      "\\ w a": "agent::ToggleFocus",
      "\\ w s": "outline_panel::ToggleFocus",
      "\\ w e": "editor::ToggleFocus",
      "\\ w d": "git::Diff",
      "\\ w z": "workspace::ToggleZoom",
      "ctrl-shift-l": [
        "action::Sequence",
        [
          ["pane::SplitRight", {}],
          ["task::Spawn", { "task_name": "jj l", "reveal_target": "center" }],
        ],
      ],
      "ctrl-shift-j": ["task::Spawn", { "task_name": "jj sb" }],
      "ctrl-shift-k": ["task::Spawn", { "task_name": "jj sf" }],
      "ctrl-shift-n": ["task::Spawn", { "task_name": "jj new" }],
      "ctrl-shift-m": ["task::Spawn", { "task_name": "jj squash" }],
      "ctrl-shift-r": ["task::Spawn", { "task_name": "jj revision ready" }],

      "\\ l f": ["task::Spawn", { "task_name": "forward_search" }],
      "\\ l v": ["task::Spawn", { "task_name": "latexmk (watch)" }],
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "cmd-w": "workspace::CloseActiveDock",
    },
  },
]
