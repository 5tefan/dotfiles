[
  {
    "label": "jj l",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review stack --watch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "hide": "never",
    "env": {
      "JJ_PAGER": "cat",
    },
    "allow_concurrent_runs": true,
    "use_new_terminal": false,
    "save": "none",
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": ["-f"],
      },
    },
  },
  {
    "label": "jj sf",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review sf",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "show_command": true,
    "save": "all",
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": ["-f"],
      },
    },
  },
  {
    "label": "jj sb",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review sb",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "show_command": false,
    "save": "all",
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": ["-f"],
      },
    },
  },
  {
    "label": "jj new",
    "command": "jj new",
    "hide": "always",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "show_command": false,
    "save": "all",
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": ["-f"],
      },
    },
  },
  {
    "label": "jj squash",
    "command": "jj squash && jj edit @-",
    "hide": "always",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "show_command": false,
    "save": "all",
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": ["-f"],
      },
    },
  },
  {
    "label": "jj revision ready",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review ready",
    "cwd": "$ZED_WORKTREE_ROOT",
    "hide": "on_success",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "show_command": false,
    "save": "none",
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": ["-f"],
      },
    },
  },
  {
    "label": "PR: open for review",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review open",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
    "allow_concurrent_runs": false,
    "use_new_terminal": true,
    "show_command": false,
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": ["-f"],
      },
    },
  },
  // Selection data stays in Zed's task environment, never in a shell command.
  {
    "label": "PR: add comment",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review comment",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "reveal": "always",
    "hide": "never",
    "allow_concurrent_runs": false,
    "use_new_terminal": true,
    "show_command": false,
  },
  {
    "label": "PR: approve",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review approve --editor 'zed --existing --wait'",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "reveal": "always",
    "hide": "never",
    "allow_concurrent_runs": false,
    "use_new_terminal": true,
    "show_command": false,
  },
  {
    "label": "PR: request changes",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review request-changes --editor 'zed --existing --wait'",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "reveal": "always",
    "hide": "never",
    "allow_concurrent_runs": false,
    "use_new_terminal": true,
    "show_command": false,
  },
  {
    "label": "PR: list comments",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review list",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "reveal": "always",
    "hide": "never",
    "allow_concurrent_runs": false,
    "use_new_terminal": true,
    "show_command": false,
  },
  {
    "label": "PR: full diff",
    "command": "~/.config/zed/zed-pr-review/target/release/zed-pr-review diff",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "reveal": "always",
    "hide": "never",
    "allow_concurrent_runs": false,
    "use_new_terminal": true,
    "show_command": false,
  },
]
