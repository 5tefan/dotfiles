// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "terminal": {
    "dock": "bottom",
  },
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "right",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true,
    },
    "dock": "left",
    "tool_permissions": {
      "tools": {
        "write_file": {
          "default": "allow",
        },
        "terminal": {
          "always_deny": [
            { "pattern": "^(sed|awk|cat|find|git)\\b" },
            { "pattern": "/tmp" },
          ],
          "always_allow": [
            // Project commands
            { "pattern": "^source\\s+\\.venv/bin/activate\\b" },
            { "pattern": "^\\./manage\\.py (test|graphql)\\b" },
            { "pattern": "^bin/(format|ci)\\b" },
            { "pattern": "^doppler run -- bunx langfuse-cli\\b" },
            { "pattern": "^jj new\\b" },
            { "pattern": "^shamecube\\b" },
            // more projects
            { "pattern": "^cargo\\s" },
            { "pattern": "^tree\\-sitter\\b.*(\\s|$)" },

            // Frontend
            { "pattern": "cd (intern|tiger_lily)/frontend\\b" },
            { "pattern": "(yarn|npx) (tsc|lint)\\b" },
            { "pattern": "ls intern/frontend/src/__generated__" },

            // Linters / type checkers
            { "pattern": "^(ruff|mypy)\\b" },

            // Read-only shell utilities
            { "pattern": "^(rg|grep|head|tail|sort|uniq|wc|jq|echo|tr)\\b" },
          ],
        },
      },
    },
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": false,
          "spawn_agent": true,
          "terminal": true,
          "update_plan": true,
          "update_title": true,
          "search_web": true,
        },
      },
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.7",
        "enable_thinking": true,
        "effort": "medium",
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.5",
        "enable_thinking": true,
        "effort": "medium",
      },
      {
        "provider": "ollama",
        "model": "qwen3.6:27b-mtp-bf16",
        "enable_thinking": true,
      },
    ],
    "enable_feedback": false,
    "default_profile": "write",
    "notify_when_agent_waiting": "primary_screen",
    "play_sound_when_agent_done": "always",
  },
  "autosave": "on_focus_change",
  "base_keymap": "JetBrains",
  "buffer_font_size": 12,
  "colorize_brackets": true,
  "cli_default_open_behavior": "new_window",
  "close_on_file_delete": true,
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [".env"],
  },
  "excerpt_context_lines": 10,
  "expand_excerpt_lines": 15,
  "format_on_save": "on",
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
    },
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "languages": {
    "HTML": {
      "show_edit_predictions": true,
    },
    "TSX": {
      "show_edit_predictions": true,
    },
    "Python": {
      "show_edit_predictions": true,
      "language_servers": ["!pylsp", "pyright"],
      "formatter": [
        {
          "external": {
            "command": "black",
            "arguments": ["-"],
          },
        },
        {
          "external": {
            "command": "isort",
            "arguments": ["-d", "-"],
          },
        },
      ],
    },
  },
  "language_models": {
    "llama.cpp": {
      "api_url": "http://localhost:10800",
      "auto_discover": true,
    },
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": false,
          },
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "minimap": {
    "show": "always",
    "current_line_highlight": "all",
  },
  "show_edit_predictions": false,
  "theme": "One Dark",
  "ui_font_size": 14,
  "unnecessary_code_fade": 0.5,
  "vim": {
    "use_system_clipboard": "never",
  },
  "vim_mode": true,
}
